<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvEditExpDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Experience Content"
        android:textColor="#121417"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Update the recorded experience message below"
        android:textColor="#616161"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etEditExpMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_floating_chat_box"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:padding="16dp"
        android:textColor="#121417"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEditExpCancel"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_cancel_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#121417"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEditExpSave"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_save_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
