<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llHistoryItemRow"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/bg_sidebar_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Chat Title"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Red Dot Unread Badge for Chat Item -->
    <View
        android:id="@+id/vChatUnreadBadge"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_circle_icon_button"
        android:backgroundTint="#EF4444"
        android:visibility="gone" />

</LinearLayout>
