<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_metallic_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvWsReminderIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_icon_button"
        android:gravity="center"
        android:text="🤖"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvWsReminderStatement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Hey Dinesh, do you remember today you have Extra Class at 2:00 PM?"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:letterSpacing="-0.01" />

</LinearLayout>
