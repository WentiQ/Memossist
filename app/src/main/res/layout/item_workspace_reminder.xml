<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_metallic_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivWsReminderIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_bell"
        app:tint="@color/icon_tint"
        android:contentDescription="Reminder Icon" />

    <TextView
        android:id="@+id/tvWsReminderStatement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Hey Dinesh, do you remember today you have Extra Class at 2:00 PM?"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:letterSpacing="-0.01" />

</LinearLayout>
