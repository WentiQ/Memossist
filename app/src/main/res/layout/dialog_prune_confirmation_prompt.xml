<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Memory Limit Reached"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvPrunePromptMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your configured memory limit is full. To store your newly extracted facts, Memossist needs to prune the lowest-strength memories."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- Summary Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_metallic_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvPruneCandidateCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memories to prune: 0"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPruneEstimatedFreed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Space to reclaim: 0 KB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPruneNewMemoriesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="New memories waiting: 0"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="If you decline, newly extracted memories will not be saved until sufficient space is created."
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Disagree / Skip Button -->
        <TextView
            android:id="@+id/btnPrunePromptDecline"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_cancel_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Don't Delete"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Agree / Prune & Save Button -->
        <TextView
            android:id="@+id/btnPrunePromptAgree"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_save_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Prune &amp; Save"
            android:textColor="@color/app_window_background"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
