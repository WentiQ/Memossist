<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Header Row (Experience ID & Tag on Left + Small Edit & Delete Icons on Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailExpId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_avatar_rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="EXP-9081"
                android:textColor="#121417"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Chat"
                android:textColor="#616161"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right Small Action Icons (Edit & Delete) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Small Edit Icon Button -->
            <ImageButton
                android:id="@+id/ibDetailEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Experience"
                android:padding="7dp"
                android:src="@drawable/ic_edit"
                app:tint="#616161" />

            <!-- Small Delete Icon Button -->
            <ImageButton
                android:id="@+id/ibDetailDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Experience"
                android:padding="7dp"
                android:src="@drawable/ic_trash"
                app:tint="#DC2626" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Timestamp Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chat_history"
            app:tint="#616161"
            android:contentDescription="Time Icon" />

        <TextView
            android:id="@+id/tvDetailTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Aug 7, 2026 • 8:30 PM"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Location Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_connections"
            app:tint="#616161"
            android:contentDescription="Location Icon" />

        <TextView
            android:id="@+id/tvDetailLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="37.7749° N, 122.4194° W • Central Cognitive Workspace"
            android:textColor="#424242"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E5E7EB" />

    <!-- Full Experience (Message) Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Experience"
        android:textColor="#616161"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Full Experience Content Box -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="200dp">

        <TextView
            android:id="@+id/tvDetailFullMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_chat_box"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="Full message content goes here..."
            android:textColor="#121417"
            android:textSize="15sp" />

    </ScrollView>

    <!-- Button to View Words & Synonyms -->
    <LinearLayout
        android:id="@+id/btnDetailWordsSynonyms"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_cancel_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_insights"
            app:tint="#121417"
            android:contentDescription="Words Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="View Words &amp; Synonyms"
            android:textColor="#121417"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Close Button -->
    <TextView
        android:id="@+id/btnDetailClose"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_save_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
