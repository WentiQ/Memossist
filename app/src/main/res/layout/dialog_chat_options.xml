<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Conversation Title Preview -->
    <TextView
        android:id="@+id/tvOptDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chat Options"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/app_card_border" />

    <!-- Action 1: Pin / Unpin -->
    <LinearLayout
        android:id="@+id/btnOptPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_cancel_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivOptPinIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pin"
            app:tint="@color/icon_tint"
            android:contentDescription="Pin Icon" />

        <TextView
            android:id="@+id/tvOptPinText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Pin Chat"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Action 2: Rename Chat -->
    <LinearLayout
        android:id="@+id/btnOptRename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_cancel_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/icon_tint"
            android:contentDescription="Rename Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Rename Chat"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Action 3: Delete Chat -->
    <LinearLayout
        android:id="@+id/btnOptDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_cancel_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_trash"
            app:tint="#DC2626"
            android:contentDescription="Delete Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Delete Chat"
            android:textColor="#DC2626"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
