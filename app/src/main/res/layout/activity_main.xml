<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Main Content Canvas Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- Active Chat Messages List (Full height from top to bottom edge) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="76dp"
            android:paddingBottom="96dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Top Fade Gradient Overlay (White to Transparent) -->
        <View
            android:id="@+id/vTopGradientOverlay"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_top_chat_gradient"
            android:clickable="false"
            android:elevation="6dp"
            android:focusable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hamburger Side Menu Button (Floating above top gradient) -->
        <ImageButton
            android:id="@+id/btnHamburger"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Open Navigation Menu"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#121417" />

        <!-- Header Delete Active Chat Action Button -->
        <ImageButton
            android:id="@+id/btnDeleteCurrentChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Delete Conversation"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/btnHeaderNewChat"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#DC2626" />

        <!-- Header New Chat Action Button -->
        <ImageButton
            android:id="@+id/btnHeaderNewChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Start New Chat"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#121417" />

        <!-- User Greeting Section (Visible when no active conversation) -->
        <LinearLayout
            android:id="@+id/llGreetingContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            app:layout_constraintBottom_toTopOf="@+id/llChatInputBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnHamburger"
            app:layout_constraintVertical_bias="0.45">

            <!-- Dynamic Greeting Header (e.g., "Good afternoon,") -->
            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good afternoon,"
                android:textColor="#616161"
                android:textSize="26sp"
                android:letterSpacing="0.01" />

            <!-- Premium Prompt Heading -->
            <TextView
                android:id="@+id/tvGreetingPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="What would you like to recall today?"
                android:textColor="#121417"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:letterSpacing="-0.02" />

        </LinearLayout>

        <!-- Floating Bottom Fade Gradient Overlay (Transparent to Opaque White) -->
        <View
            android:id="@+id/vBottomGradientOverlay"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_bottom_chat_gradient"
            android:clickable="false"
            android:elevation="6dp"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Gemini-Style Floating Chat Input Bar & Buttons -->
        <LinearLayout
            android:id="@+id/llChatInputBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_floating_chat_box"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- (+) Attachment / Action Button -->
            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Add Attachment"
                android:padding="8dp"
                android:src="@drawable/ic_plus"
                app:tint="#424242" />

            <!-- Multiline Chat Input Box -->
            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@null"
                android:hint="Ask Memossist..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:paddingVertical="6dp"
                android:textColor="#121417"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp" />

            <!-- Microphone / Voice Input Button -->
            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Voice Input"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                app:tint="#424242" />

            <!-- Live Voice Conversation Button -->
            <ImageButton
                android:id="@+id/btnLiveVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Live Voice Conversation"
                android:padding="8dp"
                android:src="@drawable/ic_live_voice"
                app:tint="#424242" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer Container -->
    <RelativeLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <!-- Navigation View for top and scrollable history -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/vSettingsDivider"
            android:background="#FFFFFF"
            android:fitsSystemWindows="false"
            app:elevation="0dp"
            app:insetForeground="@android:color/transparent"
            app:headerLayout="@layout/nav_header_main"
            app:menu="@menu/side_navigation_menu"
            app:itemIconTint="#121417"
            app:itemTextColor="#121417"
            app:itemBackground="@android:color/transparent" />

        <!-- Separation Line (Matches menu separation line above recent history) -->
        <View
            android:id="@+id/vSettingsDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@+id/llPinnedSettings"
            android:background="#E5E7EB" />

        <!-- Pinned Settings Button at bottom (Pure white background with no black/grey gradient) -->
        <LinearLayout
            android:id="@+id/llPinnedSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_settings"
                app:tint="#424242"
                android:contentDescription="Settings Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Settings"
                android:textColor="#121417"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
