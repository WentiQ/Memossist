<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Main Content Canvas Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- Active Chat Messages List (Full height from top to bottom edge) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="76dp"
            android:paddingBottom="140dp"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Top Fade Gradient Overlay (White to Transparent) -->
        <View
            android:id="@+id/vTopGradientOverlay"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_top_chat_gradient"
            android:clickable="false"
            android:elevation="6dp"
            android:focusable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hamburger Side Menu Button (Floating above top gradient) -->
        <ImageButton
            android:id="@+id/btnHamburger"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Open Navigation Menu"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#121417" />

        <!-- Gemini-Style Header Model Selector Pill -->
        <LinearLayout
            android:id="@+id/btnHeaderModelPicker"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_model_pill"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnHamburger"
            app:layout_constraintStart_toEndOf="@+id/btnHamburger"
            app:layout_constraintTop_toTopOf="@+id/btnHamburger">

            <TextView
                android:id="@+id/tvHeaderModelIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvHeaderModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Qwen3.5 4B"
                android:textColor="#121417"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▾"
                android:textColor="#616161"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Header Delete Active Chat Action Button -->
        <ImageButton
            android:id="@+id/btnDeleteCurrentChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Delete Conversation"
            android:elevation="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/flHeaderNotifications"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#DC2626" />

        <!-- Header Notification Center Action Button (Replaces top Plus icon) -->
        <FrameLayout
            android:id="@+id/flHeaderNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:elevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnHeaderNotifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Open Notification Center"
                android:padding="10dp"
                android:src="@drawable/ic_bell"
                app:tint="#121417" />

            <!-- Red Unread Badge Indicator Dot -->
            <View
                android:id="@+id/vHeaderUnreadBadge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_red_dot"
                android:elevation="12dp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- User Greeting Section (Visible when no active conversation) -->
        <LinearLayout
            android:id="@+id/llGreetingContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            app:layout_constraintBottom_toTopOf="@+id/llChatInputBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnHamburger"
            app:layout_constraintVertical_bias="0.45">

            <!-- Dynamic Greeting Header (e.g., "Good afternoon,") -->
            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good afternoon,"
                android:textColor="#616161"
                android:textSize="26sp"
                android:letterSpacing="0.01" />

            <!-- Premium Prompt Heading -->
            <TextView
                android:id="@+id/tvGreetingPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="What would you like to recall today?"
                android:textColor="#121417"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:letterSpacing="-0.02" />

            <!-- Conversational Assistant Reminders Section -->
            <LinearLayout
                android:id="@+id/llWorkspaceRemindersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkspaceReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Floating Bottom Fade Gradient Overlay (Transparent to Opaque White) -->
        <View
            android:id="@+id/vBottomGradientOverlay"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_bottom_chat_gradient"
            android:clickable="false"
            android:elevation="6dp"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Attachment Previews Container (Visible when user selects attachments via + button) -->
        <LinearLayout
            android:id="@+id/llAttachmentPreviewContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="9dp"
            app:layout_constraintBottom_toTopOf="@+id/llChatInputBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttachmentPreviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <!-- Gemini-Style Floating Chat Input Bar & Buttons -->
        <LinearLayout
            android:id="@+id/llChatInputBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_floating_chat_box"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- (+) Attachment / Action Button -->
            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Add Attachment"
                android:padding="8dp"
                android:src="@drawable/ic_plus"
                app:tint="#424242" />

            <!-- Multiline Chat Input Box -->
            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@null"
                android:hint="Ask Memossist..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:paddingVertical="6dp"
                android:textColor="#121417"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp" />

            <!-- Microphone / Voice Input Button -->
            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Voice Input"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                app:tint="#424242" />

            <!-- Live Voice Conversation Button -->
            <ImageButton
                android:id="@+id/btnLiveVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Live Voice Conversation"
                android:padding="8dp"
                android:src="@drawable/ic_live_voice"
                app:tint="#424242" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer Container -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 1. FIXED TOP HEADER & WORKSPACE NAVIGATION ITEMS (Does NOT scroll) -->
        <LinearLayout
            android:id="@+id/llFixedSidebarHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <!-- Brand Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="Memossist Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memossist"
                        android:textColor="#121417"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Cognitive Workspace"
                        android:textColor="#616161"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- "+ New Chat" Button Pill -->
            <LinearLayout
                android:id="@+id/btnSidebarNewChat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_cancel_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_plus"
                    app:tint="#121417"
                    android:contentDescription="New Chat Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="New Chat"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Workspace Navigation Menu Items (Consistent Bold Weight) -->
            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#121417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Home Workspace"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavReminders"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_alarm"
                    app:tint="#121417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Smart Reminders"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavVault"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_vault"
                    app:tint="#121417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Memory Vault"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavInsights"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_insights"
                    app:tint="#121417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Cognitive Insights"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavConnections"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_connections"
                    app:tint="#121417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Connections"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Separation Line Above History -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#E5E7EB" />

            <!-- Recent History Subheader Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Recent History"
                android:textColor="#616161"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 2. SCROLLABLE RECENT HISTORY LIST ONLY -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSidebarHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingVertical="4dp" />

        <!-- Separation Line Above Settings -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

        <!-- 3. FIXED BOTTOM PINNED SETTINGS & HELP (Does NOT scroll) -->
        <LinearLayout
            android:id="@+id/llPinnedBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/llPinnedSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#424242"
                    android:contentDescription="Settings Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Settings"
                    android:textColor="#121417"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Help Icon Button (Right side of Settings button) -->
            <ImageButton
                android:id="@+id/btnSidebarHelp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Background &amp; OEM Battery Help"
                android:padding="9dp"
                android:src="@drawable/ic_help"
                app:tint="#121417" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
