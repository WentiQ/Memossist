<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Memossist AI Avatar Badge -->
    <TextView
        android:id="@+id/tvAiAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_profile_avatar_rounded"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_metallic_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Realtime Live Thinking / Processing Steps Stream with WhatsApp Typing Dots -->
        <LinearLayout
            android:id="@+id/llThinkingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <com.example.apptempleate.TypingDotsView
                android:id="@+id/typingDotsView"
                android:layout_width="38dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvThinkingStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1/6: Retrieving memories..."
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Final Clean Humanoid Answer Text -->
        <TextView
            android:id="@+id/tvAiMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="Memossist response"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Attached Media & Files from Used Experiences -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAiAttachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

</LinearLayout>
