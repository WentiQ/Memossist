<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:padding="24dp"
    tools:context=".AlarmAlertActivity">

    <!-- Top Pulsing Alarm Orb Icon Container -->
    <LinearLayout
        android:id="@+id/llAlarmOrbContainer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_circle_icon_button"
        android:backgroundTint="#26DC2626"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAlarmIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_alarm"
            app:tint="#DC2626"
            android:contentDescription="Alarm Icon" />

    </LinearLayout>

    <!-- Subtitle Badge -->
    <TextView
        android:id="@+id/tvAlarmBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_tag_rounded"
        android:backgroundTint="#26DC2626"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="🚨 SMART ALARM REMINDER"
        android:textColor="#EF4444"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llAlarmOrbContainer" />

    <!-- Reminder Title -->
    <TextView
        android:id="@+id/tvAlarmTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Extra Class"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmBadge" />

    <!-- Humanoid Message Card Container -->
    <LinearLayout
        android:id="@+id/llMessageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_gemini_chat_box"
        android:backgroundTint="#1F2937"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmTitle">

        <TextView
            android:id="@+id/tvAlarmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Hey Dinesh, do you remember today you have extra class at 2pm right?"
            android:textColor="#E5E7EB"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:tint="#9CA3AF"
                android:contentDescription="Clock" />

            <TextView
                android:id="@+id/tvAlarmEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Scheduled for Today at 2:00 PM"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Action Buttons Container -->
    <LinearLayout
        android:id="@+id/llActionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary Action: Got It / Done -->
        <LinearLayout
            android:id="@+id/btnAlarmGotIt"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_save_pill"
            android:backgroundTint="#10B981"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle"
                app:tint="#FFFFFF"
                android:contentDescription="Check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Got It / Done"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Secondary Action: Snooze 10 Mins -->
        <LinearLayout
            android:id="@+id/btnAlarmSnooze"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_cancel_pill"
            android:backgroundTint="#374151"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_clock"
                app:tint="#F3F4F6"
                android:contentDescription="Snooze" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Snooze 10 Minutes"
                android:textColor="#F3F4F6"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Dismiss Link -->
        <TextView
            android:id="@+id/btnAlarmDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="Dismiss Alert"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
