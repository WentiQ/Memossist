<resources>
    <style name="Theme.AppTempeLate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable Action Bar Header -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:statusBarColor">@color/app_window_background</item>
        <item name="android:navigationBarColor">@color/app_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/app_window_background</item>
        <item name="colorSurface">@color/app_surface_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackgroundFloating">@color/app_surface_background</item>
    </style>

    <style name="ShapeAppearance.App.RoundedSquare" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
